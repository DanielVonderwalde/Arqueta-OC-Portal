{
  "rules": {
    ".read": false,
    ".write": false,

    "arqueta_db": {
      ".read": true,
      ".write": true,
      "clients": { ".indexOn": ["id", "portal_email", "portal_active", "activo"] },
      "quotes": { ".indexOn": ["id", "client_id", "status", "date", "activo"] },
      "costBreakdown": { ".indexOn": ["id", "quote_id", "activo"] },
      "clientOCs": { ".indexOn": ["id", "client_id", "status", "date_submitted", "activo"] },
      "purchaseOrders": { ".indexOn": ["id", "quote_id", "client_id", "status", "activo"] },
      "notifEmails": { ".indexOn": ["id"] }
    },

    "arqueta_files": {
      ".read": true,
      ".write": true
    },

    "arqueta_backups": {
      ".read": true,
      ".write": true
    },

    "documents": {
      ".read": false,
      ".write": false,
      ".indexOn": ["id", "quote_id", "client_oc_id", "client_id"]
    },

    "private": {
      ".read": false,
      ".write": false,
      "credentials": {
        "users": { ".indexOn": ["user", "role", "activo"] },
        "clients": { ".indexOn": ["email_lower", "activo"] }
      },
      "sessions": { ".indexOn": ["sub"] },
      "auditLog": { ".indexOn": ["at", "actor", "targetId"] }
    }
  }
}
