{
  "rules": {
    ".read": false,
    ".write": false,

    "arqueta_db": {
      ".read": true,
      ".write": true,
      "clients": { ".indexOn": ["id", "portal_email", "portal_active"] },
      "quotes": { ".indexOn": ["id", "client_id", "status", "date"] },
      "costBreakdown": { ".indexOn": ["id", "quote_id"] },
      "clientOCs": { ".indexOn": ["id", "client_id", "status", "date_submitted"] },
      "purchaseOrders": { ".indexOn": ["id", "quote_id", "client_id", "status"] }
    },

    "arqueta_files": {
      ".read": true,
      ".write": true
    },

    "arqueta_backups": {
      ".read": true,
      ".write": true
    },

    "documents": {
      ".read": false,
      ".write": false,
      ".indexOn": ["quote_id", "client_oc_id", "client_id"]
    },

    "private": {
      ".read": false,
      ".write": false,
      "credentials": {
        "users": { ".indexOn": ["user", "role"] },
        "clients": { ".indexOn": ["email_lower"] }
      },
      "sessions": { ".indexOn": ["sub"] }
    }
  }
}
