{
  "database": {
    "rules": "database.rules.transitional.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "codebase": "api",
    "runtime": "nodejs20",
    "ignore": [
      "node_modules",
      ".git",
      "*.local",
      "test"
    ],
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run lint",
      "npm --prefix \"$RESOURCE_DIR\" test"
    ]
  },
  "emulators": {
    "functions": { "port": 5001 },
    "database": { "port": 9000 },
    "storage": { "port": 9199 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
